  "reproduction": {
    "analyze.py": "\"\"\"Public diagnostic: edge association conditional on both word lengths.\"\"\"\nimport hashlib, json, math, random, sys\nfrom collections import Counter, defaultdict\nfrom pathlib import Path\n\nREPO = Path(__file__).resolve().parent.parent / 'voynich-swarm'\nsys.path.insert(0, str(REPO))\nfrom vs import corpus, ivtff\n\nROOT = Path(__file__).resolve().parent\nPLAN = {\n 'hypothesis': 'Adjacent word edges remain associated beyond the exact lengths of both words and the line word inventory.',\n 'statistic': 'Weighted conditional mutual information of last/first EVA-basic glyph given exact left/right EVA-basic lengths; bits per adjacent pair.',\n 'selection': 'Certain literal adjacent words of P lines only. Uncertain/empty words stay barriers; never join across a line.',\n 'null': 'Permute intact certain words only within (original line, exact EVA-basic length) cells; all positions and uncertain barriers fixed.',\n 'replicates': 199, 'seed': 2711202601, 'alpha': 0.01,\n 'partitions': ['public practice training','public practice evaluation'],\n 'editions': ['zl','it'],\n 'decision': 'Report all four tests. The primary replication requires evaluation p<=.01 in both editions and at least30 potentially movable adjacent pairs each. No threshold selection after results.',\n 'limits': 'Exploratory new diagnostic relative to existing edge-MI facts, not a trusted DSL metric or hidden-page fact. No causal or linguistic interpretation from a rejection alone.'}\n\ndef lines(pages):\n    out=[]\n    for p in pages:\n        for ln in p.lines:\n            if ln.unit!='P': continue\n            row=[None if ivtff.uncertain(w) else tuple(ivtff.segment(w,'eva-basic')) or None for w in ln.words]\n            groups=defaultdict(list)\n            for i,w in enumerate(row):\n                if w: groups[len(w)].append(i)\n            out.append((row,list(groups.values())))\n    return out\n\ndef measure(rows):\n    joint=Counter(); left=Counter(); right=Counter(); strata=Counter()\n    for row,_ in rows:\n        for a,b in zip(row,row[1:]):\n            if not a or not b: continue\n            z=(len(a),len(b)); x,y=a[-1],b[0]\n            joint[z,x,y]+=1;left[z,x]+=1;right[z,y]+=1;strata[z]+=1\n    n=sum(joint.values())\n    value=sum(c*math.log2(c*strata[z]/(left[z,x]*right[z,y])) for (z,x,y),c in joint.items())/n\n    return value,n,len(strata)\n\ndef run(pages):\n    rows=lines(pages); observed,n,k=measure(rows)\n    movable=0\n    for row,groups in rows:\n        indices={i for g in groups if len({row[j] for j in g})>1 for i in g}\n        movable+=sum(bool(a and b) and (i in indices or i+1 in indices) for i,(a,b) in enumerate(zip(row,row[1:])))\n    rng=random.Random(PLAN['seed']); values=[]\n    for _ in range(PLAN['replicates']):\n        shuffled=[]\n        for row,groups in rows:\n            target=list(row)\n            for g in groups:\n                words=[row[i] for i in g];rng.shuffle(words)\n                for i,w in zip(g,words): target[i]=w\n            shuffled.append((target,groups))\n        values.append(measure(shuffled)[0])\n    p=(1+sum(x>=observed for x in values))/(1+len(values))\n    return {'pages':len(pages),'adjacent_pairs':n,'length_pair_strata':k,'potentially_movable_pairs':movable,\n            'observed_bits':observed,'null_mean':sum(values)/len(values),'null_min':min(values),'null_max':max(values),\n            'excess_over_null_mean':observed-sum(values)/len(values),'p':p,'passes':p<=PLAN['alpha'] and movable>=30,\n            'null_values':values}\n\nif __name__=='__main__':\n    if sys.argv[-1]=='--plan':\n        (ROOT/'plan.json').write_text(json.dumps(PLAN,indent=2)+'\\n',encoding='utf-8')\n        print('plan saved');sys.exit()\n    assert json.loads((ROOT/'plan.json').read_text())==PLAN\n    results={}\n    for ed in PLAN['editions']:\n        tr,ev=corpus.split_pages('practice',ed)\n        results[ed]={}\n        for label,pages in [('train',tr),('eval',ev)]:\n            results[ed][label]=run(pages)\n            print(ed,label,{k:v for k,v in results[ed][label].items() if k!='null_values'},flush=True)\n    files={s:hashlib.sha256((REPO/'data/raw'/s).read_bytes()).hexdigest() for s in ['ZL3b-n.txt','IT2a-n.txt']}\n    (ROOT/'results.json').write_text(json.dumps({'plan':PLAN,'source_sha256':files,'results':results},indent=2)+'\\n',encoding='utf-8')\n",
    "plan.json": "{\n  \"hypothesis\": \"Adjacent word edges remain associated beyond the exact lengths of both words and the line word inventory.\",\n  \"statistic\": \"Weighted conditional mutual information of last/first EVA-basic glyph given exact left/right EVA-basic lengths; bits per adjacent pair.\",\n  \"selection\": \"Certain literal adjacent words of P lines only. Uncertain/empty words stay barriers; never join across a line.\",\n  \"null\": \"Permute intact certain words only within (original line, exact EVA-basic length) cells; all positions and uncertain barriers fixed.\",\n  \"replicates\": 199,\n  \"seed\": 2711202601,\n  \"alpha\": 0.01,\n  \"partitions\": [\n    \"public practice training\",\n    \"public practice evaluation\"\n  ],\n  \"editions\": [\n    \"zl\",\n    \"it\"\n  ],\n  \"decision\": \"Report all four tests. The primary replication requires evaluation p<=.01 in both editions and at least30 potentially movable adjacent pairs each. No threshold selection after results.\",\n  \"limits\": \"Exploratory new diagnostic relative to existing edge-MI facts, not a trusted DSL metric or hidden-page fact. No causal or linguistic interpretation from a rejection alone.\"\n}\n",
