    "reproduction": {
      "public_onsets.py": "\"\"\"Verify the proposed ratio and a stricter within-page, line-initial-only control.\"\"\"\nfrom collections import defaultdict\nimport json\nimport math\nfrom pathlib import Path\n\nfrom vs import corpus, dsl\n\nROOT = Path(__file__).resolve().parent\nSPEC = json.loads((ROOT / \"fact-spec.json\").read_text())\n\n\ndef choose(n, k):\n    return math.comb(n, k) if 0 <= k <= n else 0\n\n\ndef exact_tail(rows):\n    coefficients = [1.0]\n    observed = 0\n    mixed = 0\n    expected = 0.0\n    for values in rows.values():\n        lab, par, lab_o, par_o = values\n        if not lab or not par:\n            continue\n        mixed += 1\n        hits = lab_o + par_o\n        n = lab + par\n        observed += lab_o\n        expected += lab * hits / n\n        denominator = choose(n, lab)\n        low, high = max(0, lab - (n - hits)), min(lab, hits)\n        weights = [choose(hits, k) * choose(n - hits, lab - k) / denominator for k in range(low, high + 1)]\n        new = [0.0] * (len(coefficients) + high)\n        for current, value in enumerate(coefficients):\n            for k, weight in enumerate(weights, low):\n                new[current + k] += value * weight\n        coefficients = new\n    assert abs(math.fsum(coefficients) - 1) < 1e-10\n    return {\"mixed_pages\": mixed, \"expected_label_o\": expected, \"observed_label_o\": observed,\n            \"exact_upper_tail\": math.fsum(coefficients[observed:])}\n\n\ndef count(pages, with_dsl):\n    tokens = dsl.select(dsl.tokens(pages), SPEC.get(\"select\"))\n    metric = SPEC[\"statistic\"][\"ratio\"]\n    selected = {kind: dsl.select(tokens, metric[selection])\n                for kind, selection in ((\"L\", \"of\"), (\"P\", \"to\"))}\n    rows = defaultdict(lambda: [0, 0, 0, 0])\n    for column, kind in enumerate((\"L\", \"P\")):\n        for token in selected[kind]:\n            rows[token[\"page\"]][column] += 1\n            starts_o = dsl.feature({\"prefix\": 1}, token[\"w\"]) == [\"o\"]\n            rows[token[\"page\"]][2 + column] += int(starts_o)\n    totals = [sum(row[i] for row in rows.values()) for i in range(4)]\n    mixed = [row for row in rows.values() if row[0] and row[1]]\n    restricted = [sum(row[i] for row in mixed) for i in range(4)]\n    result = {\n        \"pages\": len(pages), \"label_first\": {\"o_initial\": totals[2], \"tokens\": totals[0]},\n        \"paragraph_first\": {\"o_initial\": totals[3], \"tokens\": totals[1]},\n        \"ratio\": (totals[2] / totals[0]) / (totals[3] / totals[1]),\n        \"mixed_only\": {\n            \"label_first\": {\"o_initial\": restricted[2], \"tokens\": restricted[0]},\n            \"paragraph_first\": {\"o_initial\": restricted[3], \"tokens\": restricted[1]},\n        },\n        \"line_initial_only_exact_same_page_shuffle\": exact_tail(rows),\n    }\n    if with_dsl:\n        result[\"dsl\"] = dsl.evaluate(SPEC, pages)\n        assert abs(result[\"ratio\"] - result[\"dsl\"][\"value\"]) < 1e-6\n    return result\n\n\ndef main():\n    confirmed = {}\n    for variant in (\"zl\", \"it\", \"rf\"):\n        train, evaluation = corpus.split_pages(\"practice\", variant)\n        confirmed[variant] = {\n            \"public_train\": count(train, False),\n            \"public_eval\": count(evaluation, True),\n        }\n    (ROOT / \"practice-results.json\").write_text(json.dumps(confirmed, indent=2) + \"\\n\")\n    print(json.dumps(confirmed, indent=2))\n\n\nif __name__ == \"__main__\":\n    main()\n",
      "label_onset_sensitivity.py": "\"\"\"Public-practice label-versus-paragraph onset sensitivity, without fact scoring.\"\"\"\n\nimport argparse\nfrom bisect import bisect_right\nfrom collections import Counter, defaultdict\nfrom dataclasses import dataclass\nfrom itertools import accumulate\nimport json\nfrom math import comb, fsum\nfrom pathlib import Path\nimport random\n\nfrom vs import corpus, dsl, ivtff\n\n\nSEED = 125601\nPERMUTATIONS = 999\nUNITS = (\"L\", \"P\")\n\n\n@dataclass(frozen=True)\nclass Layer:\n    n: int\n    o: int\n\n\n@dataclass(frozen=True)\nclass Stratum:\n    folio: str\n    quire: str\n    length: int\n    label: Layer\n    paragraph: Layer\n\n    @property\n    def weight(self):\n        return self.label.n * self.paragraph.n / (self.label.n + self.paragraph.n)\n\n\ndef cells(pages, scope):\n    quire = {page.id: page.meta.get(\"Q\", \"unknown\") for page in pages}\n    counts = defaultdict(lambda: {unit: Counter() for unit in UNITS})\n    selection = {\"unit\": list(UNITS), \"position\": \"line_initial\", \"certain\": True}\n    for token in dsl.select(dsl.tokens(pages, scope), selection):\n        glyphs = ivtff.segment(token[\"w\"], \"eva-basic\")\n        if glyphs:\n            counts[token[\"folio\"], len(glyphs)][token[\"unit\"]][glyphs[0] == \"o\"] += 1\n    return [Stratum(folio, quire[folio], length,\n                    *(Layer(sum(c[unit].values()), c[unit][True]) for unit in UNITS))\n            for (folio, length), c in sorted(counts.items())]\n\n\ndef raw(strata):\n    def layer(attr):\n        rows = [getattr(x, attr) for x in strata]\n        n, o = sum(x.n for x in rows), sum(x.o for x in rows)\n        return {\"n\": n, \"prefix_o\": o, \"rate\": o / n if n else None}\n\n    label, paragraph = (layer(kind) for kind in (\"label\", \"paragraph\"))\n    effective = label[\"rate\"] is not None and paragraph[\"rate\"] is not None\n    return {\"pages\": len({s.folio for s in strata}), \"strata\": len(strata),\n            \"label\": label, \"paragraph_line\": paragraph,\n            \"difference\": label[\"rate\"] - paragraph[\"rate\"] if effective else None}\n\n\ndef standardized(strata):\n    weight = fsum(s.weight for s in strata)\n    if not weight:\n        return {\"weight\": 0.0, \"label_rate\": None, \"paragraph_line_rate\": None, \"difference\": None}\n    label = fsum(s.weight * s.label.o / s.label.n for s in strata) / weight\n    paragraph = fsum(s.weight * s.paragraph.o / s.paragraph.n for s in strata) / weight\n    return {\"weight\": weight, \"label_rate\": label, \"paragraph_line_rate\": paragraph, \"difference\": label - paragraph}\n\n\ndef _hypergeom(stratum):\n    label, paragraph = stratum.label, stratum.paragraph\n    hits = label.o + paragraph.o\n    misses = label.n + paragraph.n - hits\n    low = max(0, label.n - misses)\n    high = min(label.n, hits)\n    weights = [comb(hits, x) * comb(misses, label.n - x) for x in range(low, high + 1)]\n    return low, tuple(accumulate(weights))\n\n\ndef conditional_shuffle(strata):\n    if not strata:\n        return None\n    cases = [_hypergeom(s) for s in strata]\n    observed = sum(s.label.o for s in strata)\n    rng = random.Random(SEED)\n    # With fixed stratum margins the weighted numerator for a cell simplifies\n    # to X - n_L*(number of hits)/N. The one-sided tail can compare integer X.\n    randomized = [sum(low + bisect_right(cumulative, rng.randrange(cumulative[-1]))\n                      for low, cumulative in cases) for _ in range(PERMUTATIONS)]\n    tail = sum(value >= observed for value in randomized)\n    return {\"seed\": SEED, \"draws\": PERMUTATIONS, \"observed_label_prefix_o\": observed,\n            \"permuted_mean_label_prefix_o\": fsum(randomized) / PERMUTATIONS,\n            \"upper_tail_including_ties\": tail, \"add_one_p\": (tail + 1) / (PERMUTATIONS + 1)}\n\n\ndef summarize(strata):\n    with_labels = {s.folio for s in strata if s.label.n}\n    with_paragraphs = {s.folio for s in strata if s.paragraph.n}\n    common_pages = with_labels & with_paragraphs\n    matched = [s for s in strata if s.label.n and s.paragraph.n]\n    by_quire = defaultdict(list)\n    for row in matched:\n        by_quire[row.quire].append(row)\n    rows = {quire: {\"raw\": raw(q), \"standardized\": standardized(q)}\n            for quire, q in sorted(by_quire.items())}\n    effects = [r[\"standardized\"][\"difference\"] for r in rows.values()]\n    return {\n        \"overall\": raw(strata),\n        \"same_pages_without_length_matching\": raw([s for s in strata if s.folio in common_pages]),\n        \"same_page_and_length_raw\": raw(matched),\n        \"same_page_and_length_standardized\": standardized(matched),\n        \"within_stratum_shuffle\": conditional_shuffle(matched),\n        \"quire_evidence\": rows,\n        \"quire_balance\": {\"positive\": sum(v > 1e-12 for v in effects),\n                          \"negative\": sum(v < -1e-12 for v in effects),\n                          \"ties\": sum(abs(v) <= 1e-12 for v in effects),\n                          \"equal_quire_mean_difference\": fsum(effects) / len(effects) if effects else None},\n    }\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--language\", choices=(\"A\", \"B\"))\n    parser.add_argument(\"--section\", choices=tuple(ivtff.SECTIONS))\n    parser.add_argument(\"--hand\")\n    parser.add_argument(\"--out\", type=Path, default=Path(__file__).with_name(\"label_onset_sensitivity.json\"))\n    args = parser.parse_args()\n    scope = {key: value for key in (\"language\", \"section\", \"hand\") if (value := getattr(args, key))}\n    out = {\"scope\": scope, \"sampling\": \"Public practice training and evaluation partitions, separately.\",\n           \"selection\": \"Certain literal first words on L label and P paragraph lines, with no promotion of a later word.\",\n           \"onset_and_length\": \"EVA-basic glyph segmentation. First glyph equals o; length is the number of segmented glyphs.\",\n           \"matching\": \"Exact folio and glyph length. A cell contributes only with both kinds. Common weight n_L*n_P/(n_L+n_P).\",\n           \"shuffle\": \"Shuffle onset indicators only within exact matched (folio, length) cells. This is a descriptive exchangeability sensitivity; the natural line kinds were not randomized.\",\n           \"transliterations\": {}}\n    for edition in (\"zl\", \"it\"):\n        train, test = corpus.split_pages(\"practice\", translit=edition)\n        out[\"transliterations\"][edition] = {name: summarize(cells(pages, scope))\n                                            for name, pages in ((\"training\", train), (\"evaluation\", test))}\n    args.out.write_text(json.dumps(out, ensure_ascii=False, indent=2, allow_nan=False) + \"\\n\", encoding=\"utf-8\")\n    for edition, entries in out[\"transliterations\"].items():\n        for split, report in entries.items():\n            print(edition, split, report[\"same_page_and_length_raw\"][\"pages\"],\n                  report[\"same_page_and_length_standardized\"][\"difference\"], report[\"quire_balance\"])\n\n\nif __name__ == \"__main__\":\n    main()\n"
    }
