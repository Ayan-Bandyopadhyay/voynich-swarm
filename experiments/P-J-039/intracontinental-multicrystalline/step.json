  "reproduction_python": "import collections,json,random\ndef stat(blocks,stop,policy):\n c=collections.Counter()\n for b in blocks:\n  if policy=='compress': seq=[w for w in b if w not in stop]\n  else:seq=[None if w in stop else w for w in b]\n  for i,a in enumerate(seq):\n   if a is None:continue\n   for v in seq[i+1:i+4]:\n    if v is None: break\n    if a!=v:c[a,v]+=1\n pairs={tuple(sorted((a,b))) for a,b in c};skew=sum(abs(c[a,b]-c[b,a])>5 for a,b in pairs);n=sum(c.values());return {'type_ratio':skew/len(pairs) if pairs else 0,'skewed_types':skew,'pair_types':len(pairs),'pair_occurrences':n,'instance_ratio':skew/n if n else 0}\n\nrng=random.Random(731); special=['w00','w01']*250;rest=[f'w{i:02}' for i in range(2,20) for _ in range(250)];rng.shuffle(rest);seq=special+rest;blocks=[seq[i:i+80] for i in range(0,5000,80)]\ndef trial(blocks,rule,policy):\n flat=[x for b in blocks for x in b];freq=collections.Counter(flat);m=max(freq.values());tied={w for w,n in freq.items() if n==m};stop=min(tied) if rule=='lex' else next(w for w in flat if w in tied)\n obs=stat(blocks,{stop},policy);r=random.Random(921);null=[]\n for _ in range(99):\n  sh=[]\n  for b in blocks:\n   x=b.copy();r.shuffle(x);sh.append(x)\n  null.append(stat(sh,{stop},policy)['type_ratio'])\n return {'stop':stop,'stat':obs,'p':(1+sum(x>=obs['type_ratio'] for x in null))/100,'null_mean':sum(null)/99}\nout=[]\nfor shift in range(20):\n mapping={f'w{i:02}':f'w{(i+shift)%20:02}' for i in range(20)};mapped=[[mapping[w] for w in b] for b in blocks]\n out.append({'shift':shift,'removed_original_lex':(20-shift)%20,'results':{rule:{policy:trial(mapped,rule,policy) for policy in ('compress','barrier')} for rule in ('lex','first')}})\nprint(json.dumps(out,indent=2))\n"
}
