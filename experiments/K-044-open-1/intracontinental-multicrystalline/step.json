  "reproduce": {
    "command": "PYTHONPATH=. python3 /tmp/voy_k044.py",
    "script": "import json\nfrom collections import defaultdict, Counter\nfrom vs import corpus, ivtff\n\ndef collect(trans):\n    train,_=corpus.split_pages('practice',trans)\n    toks=[]\n    for p in train:\n        for l in p.lines:\n            n=len(l.words)\n            if l.unit!='P' or n<3: continue\n            for i,w in enumerate(l.words):\n                if 0<i<n-1 and not ivtff.uncertain(w):\n                    toks.append((w,i/(n-1),p.section or '?', '3-7' if n<=7 else '8-11' if n<=11 else '12+'))\n    vocab={t[0] for t in toks}\n    def groups(w):\n        out=[]\n        if w.startswith('sh') and 'ch'+w[2:] in vocab: out.append(('sh/ch',0))\n        if w.startswith('ch') and 'sh'+w[2:] in vocab: out.append(('sh/ch',1))\n        if w.startswith('qo') and w[1:] in vocab: out.append(('qo/o',0))\n        if w.startswith('o') and 'q'+w in vocab: out.append(('qo/o',1))\n        for i,c in enumerate(w):\n            if c in 'kt' and w[:i]+('t' if c=='k' else 'k')+w[i+1:] in vocab:\n                out.append(('k/t',0 if c=='k' else 1)); break\n        return out\n    d=defaultdict(lambda:[[],[]])\n    for w,x,sec,length in toks:\n        for contrast,side in groups(w):\n            for strata in ('all','length:'+length,'section:'+sec,'section:'+sec+'/length:'+length): d[contrast,strata][side].append(x)\n    res={}\n    for (contrast,strata),(a,b) in sorted(d.items()):\n        if min(len(a),len(b))>=20:\n            res.setdefault(contrast,{})[strata]={'n':[len(a),len(b)],'means':[round(sum(a)/len(a),4),round(sum(b)/len(b),4)],'difference':round(sum(b)/len(b)-sum(a)/len(a),4)}\n    return res\nprint(json.dumps({t:collect(t) for t in ('zl','it')},indent=2))\n"
  },
