  "reproduction_python": "import random,json,hashlib,csv\nimport numpy as np\nfrom vs import refcorpus\nraw=open('/tmp/voy-piii.csv','rb').read();assert hashlib.sha256(raw).hexdigest()=='fe3f24a46dbc6b655eab8dbbd75addf84ee4a7dbd387ad802af75d02edfe5b4d'\ntable=list(csv.DictReader(raw.decode('utf-8-sig').splitlines()));allowed=set(table[0]);alphabet=list(table[0])\nfor row in table:\n for c in row:row[c]=row[c].strip()\ndef score(a,k):return float(np.mean(a[:-k]==a[k:]))\ndef shuffle(a,r,kind):\n if kind=='global':return r.permutation(a)\n return r.permutation(a.reshape(-1,50),axis=0).reshape(-1)\ndef infer(a,seed,kind):\n rates=[score(a,k) for k in range(2,161)];rng=np.random.default_rng(seed);null=[]\n for _ in range(49):\n  b=shuffle(a,rng,kind);null.append(max(score(b,k) for k in range(2,161)))\n return next((i+2 for i,v in enumerate(rates) if (1+sum(z>=v for z in null))/50<=.05),None)\ndef confirm(a,k,seed,kind):\n rng=np.random.default_rng(seed);v=score(a,k);return (1+sum(score(shuffle(a,rng,kind),k)>=v for _ in range(49)))/50\ndef make(plain,period,mode,seed):\n r=random.Random(seed);rows=r.sample(range(len(table)),period);words=[]\n for i,c in enumerate(plain):words.append(table[rows[r.randrange(period) if mode=='random' else i%period]][c])\n codes={w:i for i,w in enumerate(sorted(set(words)))};return np.array([codes[w] for w in words],dtype=np.int32)\nout=[]\nfor bi,book in enumerate(('la_erasmus','it_dante','de_walther')):\n pin=next(x for x in refcorpus.pins() if x['id']==book);assert hashlib.sha256(open(pin['file'],'rb').read()).hexdigest()==pin['sha256']\n plain=''.join(c for b in refcorpus.blocks_of(book) for c in b if c in allowed)[4000:12000];assert len(plain)==8000\n for seed in (1201,2201,3301):\n  ss=seed+10000*bi\n  for mode,period in (('cyclic',10),('cyclic',24),('cyclic',131),('random',131),('motif',131)):\n   use=plain\n   if mode=='motif':\n    rng=random.Random(ss+77);motif=rng.choices(alphabet,k=10);use=''.join(motif[i%10] for i in range(8000))\n   a=make(use,period,'random' if mode=='motif' else mode,ss)\n   for kind in ('global','block50'):\n    k=infer(a[:4000],ss+100,kind);p=confirm(a[4000:],k,ss+200,kind) if k else None\n    out.append({'book':book,'seed':seed,'mode':mode,'period':period,'null':kind,'lag':k,'eval_p':p})\nprint(json.dumps(out,indent=2))\n",
