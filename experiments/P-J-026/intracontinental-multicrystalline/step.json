    "period_script": "import csv,json,hashlib,random\nimport numpy as np\nfrom vs import refcorpus\nfrom collections import Counter\nraw=open('/tmp/voy-piii.csv','rb').read(); assert hashlib.sha256(raw).hexdigest()=='fe3f24a46dbc6b655eab8dbbd75addf84ee4a7dbd387ad802af75d02edfe5b4d'\ntable=list(csv.DictReader(raw.decode('utf-8-sig').splitlines()));alphabet=list(table[0]);allowed=set(alphabet)\nfor row in table:\n for c in row:row[c]=row[c].strip()\n\ndef encode(s,period,mode,seed):\n r=random.Random(seed);cols=r.sample(range(len(table)),period)\n words=[table[cols[i%period if mode=='cyclic' else r.randrange(period)]][c] for i,c in enumerate(s)]\n codes={w:i for i,w in enumerate(sorted(set(words)))}\n return np.array([codes[w] for w in words],dtype=np.int32)\ndef scores(a):return np.array([np.mean(a[:-lag]==a[lag:]) for lag in range(2,161)])\ndef infer(a,seed):\n obs=scores(a); lag=2+int(np.argmax(obs));rng=np.random.default_rng(seed);null=[]\n for i in range(49):null.append(float(max(scores(rng.permutation(a)))))\n sig=[k+2 for k,v in enumerate(obs) if (1+sum(n>=v for n in null))/50<=.05]\n return {'lag':lag,'first_significant_lag':min(sig) if sig else None,'significant_lags':sig,'peak':float(max(obs)),'max_shuffle_p':(1+sum(v>=max(obs) for v in null))/50}\nbooks=['it_villani','fr_rose'];out=[]\nfor book in books:\n source=next(x for x in refcorpus.pins() if x['id']==book)\n assert hashlib.sha256(open(source['file'],'rb').read()).hexdigest()==source['sha256']\n rawtxt=''.join(c for b in refcorpus.blocks_of(book) for c in b if c in allowed);assert len(rawtxt)>=12000\n for period in [10,24,131]:\n  for mode in ['cyclic','random']:\n   for seed in [207,411,917]:\n    # Deliberately disjoint from data used to define this simple inference rule.\n    arr=encode(rawtxt[4000:12000],period,mode,seed); fitted=infer(arr[:4000],seed+9000)\n    lag=fitted['lag'];fit=float(scores(arr[:4000])[lag-2]);evalscore=float(scores(arr[4000:])[lag-2])\n    out.append({'book':book,'period':period,'selection':mode,'seed':seed,**fitted,'held_score_at_inferred_lag':evalscore,'planted_period_score_train':float(scores(arr[:4000])[period-2]),'planted_period_score_eval':float(scores(arr[4000:])[period-2])})\nprint(json.dumps({'lag_scan':[2,160],'train_cipher_tokens':4000,'eval_cipher_tokens':4000,'shuffle_repetitions':49,'numpy_version':np.__version__,'rows':out},indent=2))\n",
