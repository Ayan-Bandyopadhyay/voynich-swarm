  "reproduction_python": "import csv,hashlib,json,random\nfrom collections import Counter,defaultdict\nimport numpy as np\nfrom vs import refcorpus\nraw=open('/tmp/voy-piii.csv','rb').read();assert hashlib.sha256(raw).hexdigest()=='fe3f24a46dbc6b655eab8dbbd75addf84ee4a7dbd387ad802af75d02edfe5b4d'\ntable=list(csv.DictReader(raw.decode('utf-8-sig').splitlines()));alphabet=list(table[0]);allowed=set(alphabet)\nfor row in table:\n for c in row:row[c]=row[c].strip()\nBOOKS=('la_augustine','es_lucanor','de_nibelunge');SEEDS=(1103,2207,3301);PERIODS=(10,24,131);MODES=('cyclic','noise2','gap1','phasejump','random','repeat10','markov')\ndef score(a,lag):return float(np.mean(a[:-lag]==a[lag:]))\ndef infer(a,seed):\n rates=np.array([score(a,k) for k in range(2,161)]);r=np.random.default_rng(seed);null=[]\n for j in range(49):\n  b=r.permutation(a);null.append(max(score(b,k) for k in range(2,161)))\n sig=[i+2 for i,v in enumerate(rates) if (1+sum(n>=v for n in null))/50<=.05]\n return (min(sig) if sig else None),(1+sum(n>=max(rates) for n in null))/50\n\ndef test_lag(a,lag,seed):\n r=np.random.default_rng(seed);v=score(a,lag);null=[score(r.permutation(a),lag) for i in range(49)];return v,(1+sum(x>=v for x in null))/50\n\nimport sys\ndef make(plain,period,seed,mode):\n r=random.Random(seed)\n rows=(r.sample(range(len(table)),period) if mode=='distinct' else r.choices(range(len(table)),k=period))\n words=[table[rows[i%period]][c] for i,c in enumerate(plain)]\n codes={w:i for i,w in enumerate(sorted(set(words)))}\n return np.array([codes[w] for w in words],dtype=np.int32), len(set(rows))\nout=[]\nfor book in ('la_erasmus','it_dante','de_walther'):\n pin=next(x for x in refcorpus.pins() if x['id']==book);assert hashlib.sha256(open(pin['file'],'rb').read()).hexdigest()==pin['sha256']\n text=''.join(c for b in refcorpus.blocks_of(book) for c in b if c in allowed);assert len(text)>=12000; plain=text[4000:12000]\n for period in (100,131,161,199,257):\n  for mode in (('distinct','replacement') if period<=len(table) else ('replacement',)):\n   for seed in (1103,2207,3301):\n    a,n=make(plain,period,seed,mode); lag,p=infer(a[:4000],seed+10000); ev,ep=(None,None) if lag is None else test_lag(a[4000:],lag,seed+20000)\n    out.append(dict(book=book,period=period,mode=mode,seed=seed,unique_rows=n,selected_lag=lag,train_maxp=p,eval_score=ev,eval_p=ep))\n print('done',book,file=sys.stderr,flush=True)\nprint(json.dumps(out,indent=2))\n"
