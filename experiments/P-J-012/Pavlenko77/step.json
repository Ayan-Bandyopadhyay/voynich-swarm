  "runner_source": "import json, pathlib, sys\nsys.path.insert(0, str(pathlib.Path('vs').resolve()))\nsys.path.insert(0, str(pathlib.Path('..').resolve()))\nsys.path.insert(0, str(pathlib.Path.cwd()))\nimport importlib.util\np=pathlib.Path('../k024-work/null_power.py')\nspec=importlib.util.spec_from_file_location('null_power',p)\nm=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\nbase=json.loads(pathlib.Path('../k024-work/plan-base.json').read_text(encoding='utf-8'))\nplans=[('replica',base)]\nfor j,(layout,mask,sim) in enumerate([(409,2402,20261127),(410,2403,20261128),(411,2404,20261129)],1):\n    q=dict(base,layout_seed=layout,mask_seed=mask,simulation_seed=sim)\n    plans.append((f'independent_{j}',q))\nsummary={}\nfor name,plan in plans:\n    print('START',name,plan['layout_seed'],plan['mask_seed'],plan['simulation_seed'],flush=True)\n    out=m.run(plan)\n    summary[name]=out\n    pathlib.Path(f'../k024-work/{name}.json').write_text(json.dumps(out,indent=2)+'\\n',encoding='utf-8')\n    print(name,'layout',out['layout'],flush=True)\n    for rate in ('0.02','0.03','0.05','0.08','0.1','0.18'):\n        print(rate,{k:round(v['rate'],3) for k,v in out['power'][rate].items()},flush=True)\npathlib.Path('../k024-work/all-runs.json').write_text(json.dumps(summary,indent=2)+'\\n',encoding='utf-8')\n",
