  "reproduction_python": "import json,random,collections\ndef stat(blocks,stop,policy):\n c=collections.Counter()\n for b in blocks:\n  if policy=='compress': seq=[w for w in b if w not in stop]\n  else:seq=[None if w in stop else w for w in b]\n  for i,a in enumerate(seq):\n   if a is None:continue\n   for v in seq[i+1:i+4]:\n    if v is None: break\n    if a!=v:c[a,v]+=1\n pairs={tuple(sorted((a,b))) for a,b in c};skew=sum(abs(c[a,b]-c[b,a])>5 for a,b in pairs);n=sum(c.values());return {'type_ratio':skew/len(pairs) if pairs else 0,'skewed_types':skew,'pair_types':len(pairs),'pair_occurrences':n,'instance_ratio':skew/n if n else 0}\n\ndef first(blocks):\n flat=[w for b in blocks for w in b];f=collections.Counter(flat);m=max(f.values());return next(w for w in flat if f[w]==m)\ndef evals(blocks,seed,policy):\n stop=first(blocks);obs=stat(blocks,{stop},policy)['type_ratio'];r=random.Random(seed);fixed=[];reselected=[]\n for _ in range(99):\n  sh=[]\n  for b in blocks:\n   a=b.copy();r.shuffle(a);sh.append(a)\n  fixed.append(stat(sh,{stop},policy)['type_ratio']);reselected.append(stat(sh,{first(sh)},policy)['type_ratio'])\n return {'score':obs,'fixed_p':(1+sum(v>=obs for v in fixed))/100,'reselected_p':(1+sum(v>=obs for v in reselected))/100,'observed_stop':stop}\nout=[]\nfor kind in ('iid_conditional','cycle'):\n for seed in range(20):\n  r=random.Random(76000+seed);tokens=[f'w{i:02}' for i in range(20) for _ in range(250)]\n  if kind=='iid_conditional':\n   r.shuffle(tokens);blocks=[tokens[i:i+100] for i in range(0,5000,100)]\n  else:blocks=[[f'w{(i+r.randrange(1))%20:02}' for i in range(100)] for _ in range(50)]\n  # Independently randomize each cyclic block phase without changing global counts.\n  if kind=='cycle':\n   blocks=[]\n   for _ in range(50):\n    phase=r.randrange(20);blocks.append([f'w{(i+phase)%20:02}' for i in range(100)])\n  out.append({'kind':kind,'seed':seed,'policies':{pol:evals(blocks,88000+seed,pol) for pol in ('compress','barrier')}})\n print(kind,'done',flush=True)\nprint(json.dumps(out,indent=2))\n"
}
