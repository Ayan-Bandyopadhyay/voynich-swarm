  "reproduction_python": "import re,html,json,random,collections,itertools,statistics,hashlib\nfrom vs import corpus,ivtff\nfrom functools import lru_cache\nfrom pathlib import Path\nreg=json.load(open('/tmp/p-g-024.json'))['detail']['evidence'];fit=reg['frozen_fit'];banks=fit['schedule'];pbank=fit['exception_bank_draw_probability']\nsrc=html.unescape(re.sub(r'<[^>]+>','',Path('/tmp/stolfi-grammar.html').read_text()))\nsrc=src[src.index('NormalWord:'):src.index('AbnormalWord:')]\ngram={};cur=None\nfor line in src.splitlines():\n m=re.match(r'^([A-Za-z][A-Za-z0-9]*):\\s*$',line)\n if m:cur=m[1];gram[cur]=[];continue\n m=re.match(r'^\\s*\\d+\\s+[\\d.]+\\s+[\\d.]+\\s+(\\S+)',line)\n if m and cur:gram[cur].append(m[1])\n@lru_cache(None)\ndef pattern(n):\n if n not in gram:return re.escape(n)\n return '(?:'+'|'.join(''.join(pattern(x) for x in alt.split('.') if x) for alt in gram[n])+')'\nnormal=re.compile('^'+pattern('NormalWord')+'$')\ndef eligible(w):return bool(re.fullmatch('[a-z]+',w))\ndef sequences(pages):\n seq=[]\n for page in pages:\n  for line in page.lines:\n   if line.unit!='P':continue\n   part=[]\n   for w in line.words:\n    if eligible(w):part.append(w)\n    elif part:seq.append(part);part=[]\n   if part:seq.append(part)\n return seq\ndef glen(w):return len(ivtff.segment(w,'eva-basic'))\ndef edit1(a,b):\n a=ivtff.segment(a,'eva-basic');b=ivtff.segment(b,'eva-basic')\n if abs(len(a)-len(b))>1:return False\n if len(a)==len(b):return sum(x!=y for x,y in zip(a,b))==1\n if len(a)>len(b):a,b=b,a\n i=0\n while i<len(a) and a[i]==b[i]:i+=1\n return a[i:]==b[i+1:]\ndef tv(a,b):\n aa=sum(a.values());bb=sum(b.values());return sum(abs(a.get(k,0)/aa-b.get(k,0)/bb) for k in set(a)|set(b))/2\ntrain,_=corpus.split_pages('practice');tr=[w for seq in sequences(train) for w in seq]; trset=set(tr)\n# Freeze: fit only ZL training length ratios; clip inverse-frequency weights to [0.25,4],\n# shared fragment probability 0.10, same bank/role only, uniform if no previous slot;\n# independent random draw 0.0531926 specialist; seed 31001-31010.\ntriples={};hist=collections.Counter()\nfor b,slots in banks.items():\n triples[b]=[(tuple(t),' '.join([]).join(sum((list(x) for x in t),[]))) for t in itertools.product(*slots)]\n for t,w in triples[b]:hist[glen(w)]+=(pbank if b=='exception_bank' else 1-pbank)/len(triples[b])\ntarget=collections.Counter(map(glen,tr));total=sum(target.values())\nweights={n:min(4,max(.25,(target[n]/total)/v)) for n,v in hist.items() if v}\nprint('training',len(tr),'abnormal',sum(not bool(normal.fullmatch(w)) for w in tr)/len(tr),'weights',weights,flush=True)\nsupport={w for t in triples.values() for _,w in t};ab_unseen={w for w in support if w not in trset and not normal.fullmatch(w)}\nprint('support',len(support),'abnormal-unseen',len(ab_unseen),flush=True)\nfor trans in ('zl','it'):\n _,ev=corpus.split_pages('practice',trans); seqs=sequences(ev); real=[w for seq in seqs for w in seq]; pairs=[(a,b) for seq in seqs for a,b in zip(seq,seq[1:])]; bylen=collections.defaultdict(list)\n for w in real:bylen[glen(w)].append(w)\n realpairs=[(a,b) for a,b in pairs if glen(a) in hist and glen(b) in hist]\n print('real',trans,len(real),len(pairs),'abnormal',sum(not bool(normal.fullmatch(w)) for w in real)/len(real),'repeat',sum(a==b for a,b in realpairs)/len(realpairs),'edit1',sum(edit1(a,b) for a,b in realpairs)/len(realpairs),'coverage',len({w for w in real if not normal.fullmatch(w) and w not in trset}&support),flush=True)\n for weighted in (True,):\n  for share in (True,):\n   for filter_on in (False,True):\n    results=[]\n    for seed in range(41001,41011):\n     rng=random.Random(seed); generated=[];gp=[]; prev=None; attempts=0\n     dist={b:list(itertools.accumulate(weights[glen(w)] if weighted else 1 for t,w in vals)) for b,vals in triples.items()}\n     for seq in seqs:\n      oldw=None;prev=None\n      for _ in seq:\n       while True:\n        attempts+=1\n        bank='exception_bank' if rng.random()<pbank else 'base