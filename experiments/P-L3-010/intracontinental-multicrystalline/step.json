    "command": "Save script to /tmp/reproduce_pl3010.py; from the project checkout after python3 -m vs fetch run PYTHONPATH=. python3 /tmp/reproduce_pl3010.py",
    "script": "import json,random,hashlib,inspect\nfrom collections import Counter\nfrom vs import corpus,ivtff,refcorpus,judge\nBOOKS=('it_dante','es_buenamor','en_paston','medieval_czech_01473c19'); DIGITS='aeio'; MARKER='y'; MAXLEN=16\n\ndef escape(word):\n if not word or len(word)>MAXLEN or not word.isascii() or not word.islower() or not word.isalpha(): raise ValueError('outside bounded alphabet')\n return MARKER+''.join(DIGITS[(ord(ch)>>s)&3] for ch in word for s in (6,4,2,0))\n\ndef unescape(s):\n if not s.startswith(MARKER) or len(s)<5 or (len(s)-1)%4 or (len(s)-1)//4>MAXLEN or any(c not in DIGITS for c in s[1:]): raise ValueError('invalid escape')\n bs=[sum(DIGITS.index(c)<<s for c,s in zip(s0,(6,4,2,0))) for s0 in (s[i:i+4] for i in range(1,len(s),4))]\n if any(not 97<=c<=122 for c in bs):raise ValueError('nonletter')\n return ''.join(chr(c) for c in bs)\n\ndef isescape(s):\n try: unescape(s);return True\n except ValueError:return False\n\ndef words(pages):\n return [w for p in pages for l in p.lines if l.unit=='P' for w in l.words if not ivtff.uncertain(w) and w.isascii() and w.isalpha() and w.islower()]\n\ndef run(train,test,codes,n,seed,evalw):\n freq=Counter(train);common=sorted(freq,key=lambda x:(-freq[x],x))[:n];codes=sorted(codes);random.Random(seed).shuffle(codes)\n enc=dict(zip(common,codes));dec={v:k for k,v in enc.items()};assert len(dec)==n and all(not w.startswith(MARKER) for w in dec)\n out=[];skipped=[]\n for w in test:\n  if w in enc:out.append(enc[w])\n  elif len(w)<=MAXLEN:out.append(escape(w))\n  else:out.append(None);skipped.append(w)\n decoded=[None if w is None else (unescape(w) if w.startswith(MARKER) else dec[w]) for w in out]\n assert decoded==[None if w is None else t for t,w in zip(test,out)]\n valid=[w for w in out if w is not None]; direct=[w for w in valid if not w.startswith(MARKER)];esc=[w for w in valid if w.startswith(MARKER)]\n kb=judge.compressed_bits(judge.canonical({'map':dec}));src=inspect.getsource(escape)+inspect.getsource(unescape)+\"DIGITS='aeio'; MARKER='y'; MAXLEN=16\\n\";pb=judge.compressed_bits(src.encode())\n return {'entries':n,'key_compressed_bits':kb,'codec_source_compressed_bits':pb,'key_bits_per_input_token':kb/len(test),'input_tokens':len(test),'literal_plaintext_utf8_bits':8*sum(len(w.encode()) for w in test),'unencodable_tokens':len(skipped),'dictionary_tokens':len(direct),'escape_tokens':len(esc),'escape_glyphs':sum(map(len,esc)),'cipher_glyphs':sum(len(ivtff.segment(w)) for w in valid),'mean_cipher_glyphs_per_encodable_token':sum(len(ivtff.segment(w)) for w in valid)/len(valid),'dictionary_mean_glyphs':sum(len(ivtff.segment(w)) for w in direct)/len(direct),'escape_mean_glyphs':sum(len(ivtff.segment(w)) for w in esc)/len(esc),'escape_payload_fixed_bits':3*sum(map(len,esc)), 'practice_membership':{name:{'dictionary_token_share':sum(w in dec for w in ws)/len(ws),'valid_escape_token_share':sum(isescape(w) for w in ws)/len(ws),'union_token_share':sum(w in dec or isescape(w) for w in ws)/len(ws)} for name,ws in evalw.items()}}\n\nif __name__=='__main__':\n for w in ('a','z','voynich','x'*16):assert unescape(escape(w))==w\n for w in ('','A','x'*17):\n  try:escape(w);raise AssertionError(w)\n  except ValueError:pass\n for s in ('y','ya','yaaaa','yaaaa'+'a'*64,'yxxxx'):\n  try:unescape(s);raise AssertionError(s)\n  except ValueError:pass\n pins={e['id']:e for e in refcorpus.pins()}\n for book in BOOKS:\n  with open(pins[book]['file'],'rb') as f: assert hashlib.sha256(f.read()).hexdigest()==pins[book]['sha256']\n for fn,sha in [('ZL3b-n.txt','bf5b6d4ac1e3a51b1847a9c388318d609020441ccd56984c901c32b09beccafc'),('IT2a-n.txt','7f27a8b0feed8f6de0a99900df6bf912dd1d295c38e5f830bac8b41c3f536fb5')]:\n  with open('data/raw/'+fn,'rb') as f:assert hashlib.sha256(f.read()).hexdigest()==sha\n tr,_=corpus.split_pages('practice','zl');lex=set(w for w in words(tr) if not w.startswith(MARKER));ev={t:words(corpus.split_pages('practice',t)[1]) for t in ('zl','it')}\n out={'candidate_types':len(lex),'witness_tokens':{k:len(v) for k,v in ev.items()},'results':{}}\n for book in BOOKS:\n  ws=' '.join(refcorpus.blocks_of(book)).split();assert len(ws)>=75000 and all(w.isascii() and w.isalpha() and w.islower() for w in ws[:75000])\n  out['results'][book]={str(n):{str(s):run(ws[:50000],ws[50000:75000],lex,n,s,ev) for s in (17,37,73)} for n in (1000,5000)}\n print(json.dumps(out,indent=2))\n"
